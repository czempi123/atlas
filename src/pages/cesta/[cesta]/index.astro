---
// Přehled cesty: otázka, úvod, Začít / Pokračovat a kroky s tím, co student prošel.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Zakladni from '../../../layouts/Zakladni.astro';
import PostupCesty from '../../../components/cesta/PostupCesty.svelte';
import Mince from '../../../components/ui/Mince.astro';
import { osoba } from '../../../lib/data';
import { krokyCesty, adresaKroku } from '../../../lib/cesty';
import { adresaOtazky } from '../../../lib/otazky';

export async function getStaticPaths() {
  const cesty = await getCollection('cesty');
  const kroky = await getCollection('kroky');
  return cesty.map((c) => ({
    params: { cesta: c.id },
    props: { cesta: c, kroky: krokyCesty(kroky.map((k) => k.data), c.id) },
  }));
}
interface Props { cesta: CollectionEntry<'cesty'>; kroky: { krok: number; nazev: string }[] }
const { cesta, kroky } = Astro.props;
const { Content } = await render(cesta);
const c = cesta.data;
const lide = c.filozofove.map(osoba);
const otazky = await getCollection('otazky');
const otazka = otazky.find((o) => o.data.cislo === c.otazka);
const odkazOtazky = otazka ? adresaOtazky(otazka.id, otazka.data) : undefined;
const seznam = kroky.map((k) => ({ n: k.krok, nazev: k.nazev, href: adresaKroku(cesta.id, k.krok) }));
---
<Zakladni
  titulek={c.nazev}
  popis={c.vstup}
  sekce="otazky"
  drobecky={[
    { text: 'Otázky', href: '/otazky/' },
    ...(otazka ? [{ text: otazka.data.otazka, href: odkazOtazky }] : []),
    { text: `Cesta ${c.cislo}` },
  ]}
>
  <article class={`cesta stranka obdobi-${c.obdobi}`}>
    <header class="cesta__hlava ctenarsky">
      <p class="t-nadtitulek nadtitulek">Cesta {c.cislo}{c.minut && <> · asi {c.minut} minut</>} · {kroky.length} kroků</p>
      <h1 class="t-h1">{c.nazev}</h1>
      <p class="t-perex">{c.vstup}</p>
      <p class="lide t-ovladani">
        {lide.map((o) => <span class="clovek"><Mince osoba={o} varianta="tint" velikost={36} /> <a href={`/osobnost/${o.id}/`}>{o.jmeno}</a></span>)}
      </p>
    </header>
    <div class="ctenarsky uvod"><Content /></div>
    <section class="ctenarsky" aria-labelledby="kroky-nadpis">
      <PostupCesty client:load varianta="prehled" slug={cesta.id} nazev={c.nazev} kroky={seznam} />
    </section>
    <section class="ctenarsky kam-dal" id="hotovo" aria-labelledby="kam-dal-nadpis">
      <h2 class="t-h3" id="kam-dal-nadpis">Kam dál</h2>
      <ul>
        {lide.map((o) => <li><a href={`/osobnost/${o.id}/`}>{o.jmeno}: celý příběh</a></li>)}
        <li><a href="/mapa/?rok=-399&osoba=sokrates">Mapa a čas: Athény roku 399 př. n. l.</a></li>
        {otazka && <li><a href={odkazOtazky}>Velká otázka {otazka.data.cislo}: {otazka.data.otazka}</a></li>}
      </ul>
    </section>
  </article>
</Zakladni>

<style>
  .cesta { padding-bottom: var(--s-8); }
  .cesta__hlava { padding: var(--s-6) 0 var(--s-4); }
  .nadtitulek { margin: 0 0 var(--s-3); color: var(--pc); }
  h1 { margin-bottom: var(--s-4); }
  .lide { display: flex; flex-wrap: wrap; gap: var(--s-4); margin: 0; }
  .clovek { display: inline-flex; align-items: center; gap: var(--s-2); }
  .uvod { margin-bottom: var(--s-6); }
  .kam-dal { margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .kam-dal ul { margin: var(--s-3) 0 0; padding-left: var(--s-5); font-family: var(--font-sans); font-size: var(--fs-ovladani-l); }
  .kam-dal li { padding: var(--s-2) 0; }
</style>
