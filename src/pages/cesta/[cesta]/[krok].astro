---
// Krok cesty: soustředěná hlavička s postupem, „Kde jsme“, obsah kroku (bloky) a lišta Předchozí / Další.
// Středová osa: nadpis a text v čtenářském sloupci uprostřed, bloky v širším pásu (960 px) na téže ose.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Zakladni from '../../../layouts/Zakladni.astro';
import CestaHlavicka from '../../../components/cesta/CestaHlavicka.astro';
import CestaLista from '../../../components/cesta/CestaLista.astro';
import { krokyCesty, adresaKroku, adresaCesty, zacatekCesty } from '../../../lib/cesty';

export async function getStaticPaths() {
  const cesty = await getCollection('cesty');
  const vse = await getCollection('kroky');
  return cesty.flatMap((c) => {
    const kroky = krokyCesty(vse.map((k) => ({ ...k.data, zaznam: k })), c.id);
    // Začátek cesty z přehledu musí stát v některém dřívějším kroku; jinak se sestavení zastaví.
    if (c.data.zacatek) zacatekCesty(vse.map((k) => ({ ...k.data, body: k.body })), c.id, c.data.zacatek);
    return kroky.map((k) => ({
      params: { cesta: c.id, krok: String(k.krok) },
      props: { cesta: c, zaznam: k.zaznam, kroky: kroky.map((x) => ({ n: x.krok, nazev: x.nazev })) },
    }));
  });
}
interface Props { cesta: CollectionEntry<'cesty'>; zaznam: CollectionEntry<'kroky'>; kroky: { n: number; nazev: string }[] }
const { cesta, zaznam, kroky } = Astro.props;
const { Content } = await render(zaznam);
const k = zaznam.data;
const c = cesta.data;
const seznam = kroky.map((x) => ({ ...x, href: adresaKroku(cesta.id, x.n) }));
const pred = seznam.find((x) => x.n === k.krok - 1);
const dal = seznam.find((x) => x.n === k.krok + 1);
---
<Zakladni titulek={`${k.nazev} · ${c.nazev}`} popis={c.vstup} hledat={false}>
  <CestaHlavicka slot="hlavicka" slug={cesta.id} nazev={c.nazev} kroky={seznam} aktualni={k.krok} />
  <article class={`krok stranka obdobi-${c.obdobi}`}>
    <header class="krok__hlava">
      <p class="t-nadtitulek nadtitulek">Krok {k.krok} · {c.nazev}</p>
      <h1 class="t-h2">{k.nazev}</h1>
      {k.kdeJsme && <p class="kde t-ovladani"><span class="t-popisek">Kde jsme:</span> {k.kdeJsme}</p>}
    </header>
    <div class="krok__obsah"><Content /></div>
  </article>
  <CestaLista
    slot="lista"
    predchozi={pred ? { href: pred.href, text: 'Předchozí' } : { href: adresaCesty(cesta.id), text: 'Přehled' }}
    dalsi={dal ? { href: dal.href, text: 'Další krok', nazev: dal.nazev } : { href: `${adresaCesty(cesta.id)}#hotovo`, text: 'Dokončit cestu' }}
  />
</Zakladni>

<style>
  .krok { padding-bottom: var(--s-6); }
  .krok__hlava { max-width: var(--ctenarsky-sloupec); margin-inline: auto; padding: var(--s-6) 0 var(--s-2); }
  .nadtitulek { margin: 0 0 var(--s-3); color: var(--pc); }
  h1 { margin-bottom: var(--s-3); }
  .kde { margin: 0; color: var(--ink-2); }
  .kde .t-popisek { color: var(--ink-2); }
  .krok__obsah { max-width: 960px; margin-inline: auto; }
  .krok__obsah :global(> .ctenarsky) { margin-inline: auto; }
  .krok__obsah :global(> .blok:first-child), .krok__obsah :global(> astro-island:first-child > .blok), .krok__obsah :global(> .ctenarsky:first-child) { margin-top: var(--s-5); }
  .krok__obsah :global(h2) { margin: var(--s-6) 0 var(--s-4); font-size: var(--fs-h3); line-height: var(--lh-h3); }
</style>
