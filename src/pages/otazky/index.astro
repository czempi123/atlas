---
// Otázky: deset velkých otázek atlasu a cesty, které k nim vedou.
import { getCollection } from 'astro:content';
import Zakladni from '../../layouts/Zakladni.astro';
import Ikona from '../../components/ui/Ikona.astro';
import { maStranku } from '../../lib/otazky';
import { cestyOtazky } from '../../lib/vstupy';
const otazky = (await getCollection('otazky')).sort((a, b) => a.data.cislo - b.data.cislo);
const cesty = (await getCollection('cesty')).map((c) => ({ slug: c.id, ...c.data }));
---
<Zakladni titulek="Otázky" sekce="otazky" drobecky={[{ text: 'Otázky' }]} kratkyTitulek="Otázky">
  <div class="stranka">
    <header class="hlava ctenarsky">
      <h1 class="t-h1">Deset velkých otázek</h1>
      <p class="t-perex">Na tyhle otázky odpovídá každá doba po svém. Než si přečteš, co říkali filozofové, zkus si odpovědět sám. U otázek najdeš i cesty, které k nim vedou.</p>
    </header>
    <ol class="otazky">
      {otazky.map((o) => (
        <li id={o.id}>
          <span class="cislo t-letopocet">{o.data.cislo}</span>
          <span class="text">
            {maStranku(o.data)
              ? <a class="t-h3" href={`/otazka/${o.id}/`}>{o.data.otazka}</a>
              : <span class="t-h3">{o.data.otazka}</span>}
            <span class="t-popisek">{o.data.disciplina}</span>
            {cestyOtazky(o.data.cislo, cesty).length > 0 && (
              <ul class="cesty" aria-label={`Cesty k otázce ${o.data.cislo}`}>
                {cestyOtazky(o.data.cislo, cesty).map((c) => (
                  <li class={`obdobi-${c.obdobi}`}>
                    <a class="cesta" href={`/cesta/${c.slug}/`}>
                      <span class="cesta__nad">Cesta {c.cislo}</span>
                      <span class="cesta__nazev">{c.nazev}</span>
                      <Ikona id="dal" velikost={18} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </span>
        </li>
      ))}
    </ol>
  </div>
</Zakladni>

<style>
  .hlava { padding: var(--s-6) 0 var(--s-5); }
  h1 { margin-bottom: var(--s-4); }
  .otazky { display: grid; gap: 0 var(--s-6); margin: 0; padding: 0; list-style: none; }
  .otazky > li { display: flex; gap: var(--s-4); align-items: baseline; padding: var(--s-4) 0; border-top: 1px solid var(--rule); }
  .cislo { flex: none; width: 2ch; font-size: 15px; font-weight: 600; color: var(--muted); }
  .text { display: flex; flex-direction: column; gap: var(--s-1); }
  .text > a { text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .cesty { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: var(--s-2) 0 0; padding: 0; list-style: none; }
  .cesta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--dotyk);
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--pc);
    border-radius: var(--r-sm);
    background: var(--surface);
    font-family: var(--font-sans);
    font-size: var(--fs-ovladani);
    line-height: 1.3;
    text-decoration: none;
  }
  .cesta:hover { background: var(--pc-tint); }
  .cesta__nad { color: var(--pc); font-weight: 600; white-space: nowrap; }
  .cesta__nazev { font-weight: 500; }
  .cesta :global(svg) { flex: none; color: var(--pc); }
  @media (min-width: 900px) { .otazky { grid-template-columns: 1fr 1fr; } }
</style>
