---
// Otázky: deset velkých otázek atlasu.
import { getCollection } from 'astro:content';
import Zakladni from '../../layouts/Zakladni.astro';
const otazky = (await getCollection('otazky')).sort((a, b) => a.data.cislo - b.data.cislo);
---
<Zakladni titulek="Otázky" sekce="otazky" drobecky={[{ text: 'Otázky' }]} kratkyTitulek="Otázky">
  <div class="stranka">
    <header class="hlava ctenarsky">
      <h1 class="t-h1">Deset velkých otázek</h1>
      <p class="t-perex">Na tyhle otázky odpovídá každá doba po svém. Než si přečteš, co říkali filozofové, zkus si odpovědět sám.</p>
    </header>
    <ol class="otazky">
      {otazky.map((o) => (
        <li id={o.id}>
          <span class="cislo t-letopocet">{o.data.cislo}</span>
          <span class="text">
            <span class="t-h3">{o.data.otazka}</span>
            <span class="t-popisek">{o.data.disciplina}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</Zakladni>

<style>
  .hlava { padding: var(--s-6) 0 var(--s-5); }
  h1 { margin-bottom: var(--s-4); }
  .otazky { display: grid; gap: 0 var(--s-6); margin: 0; padding: 0; list-style: none; }
  li { display: flex; gap: var(--s-4); align-items: baseline; padding: var(--s-4) 0; border-top: 1px solid var(--rule); }
  .cislo { flex: none; width: 2ch; font-size: 15px; font-weight: 600; color: var(--muted); }
  .text { display: flex; flex-direction: column; gap: var(--s-1); }
  @media (min-width: 900px) { .otazky { grid-template-columns: 1fr 1fr; } }
</style>
