---
// Mapa a čas: interaktivní ostrov (mapa, posuvník roku, řeka životů, karta člověka).
// Stav nese adresa: /mapa/?rok=-360&osoba=platon. Podklad mapy se předpočítá při sestavení
// (src/pages/mapa/podklad/[soubor].json.ts), data se sem vloží jako kompaktní výtah.
import { getCollection } from 'astro:content';
import Zakladni from '../../layouts/Zakladni.astro';
import MapaACas from '../../components/mapa/MapaACas.svelte';
import { vstupMapy } from '../../lib/mapa-vstup-build';

const osobnosti = (await getCollection('osobnosti')).map((o) => o.data.osoba);
const vstup = vstupMapy(osobnosti);
---
<Zakladni
  titulek="Mapa a čas"
  popis="Kdo žil s kým, kdo po kom a jak daleko od sebe: mapa myslitelů, posuvník roku a řeka životů."
  sekce="mapa"
  kratkyTitulek="Mapa a čas"
  hledat={false}
  aplikace
>
  <h1 class="vh">Mapa a čas</h1>
  <MapaACas client:load {vstup} />
</Zakladni>
