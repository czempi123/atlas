---
// Základní rozvržení všech stránek: hlavička, drobečky, obsah, spodní lišta na telefonu.
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/promitani.css';
import Pisma from '../components/rozvrzeni/Pisma.astro';
import ListaHodiny from '../components/rozvrzeni/ListaHodiny.astro';
import { KLIC_AKTIVNI } from '../lib/pruchod-hodiny';
import Hlavicka, { type Sekce } from '../components/rozvrzeni/Hlavicka.astro';
import SpodniLista from '../components/rozvrzeni/SpodniLista.astro';
import Drobecky from '../components/rozvrzeni/Drobecky.astro';

interface Props {
  titulek: string;
  popis?: string;
  sekce?: Sekce;
  drobecky?: { text: string; href?: string }[];
  zpet?: { href: string; text: string };
  /** telefonní titulek v horní liště (výchozí: Atlas myšlení) */
  kratkyTitulek?: string;
  /** stránka, kterou má Pagefind indexovat */
  hledat?: boolean;
  /** celoobrazovkový nástroj (Mapa a čas): bez drobečků a patičky, obsah vyplní okno */
  aplikace?: boolean;
  /** stránka pro autora (dílna): vyhledávače ji neindexují */
  noindex?: boolean;
}
const { titulek, popis = 'Interaktivní atlas filozofie pro střední školy: lidé, otázky, mapa a čas.', sekce, drobecky, zpet, kratkyTitulek, hledat = true, aplikace = false, noindex = false } = Astro.props;
const plnyTitulek = titulek === 'Atlas myšlení' ? titulek : `${titulek} · Atlas myšlení`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{plnyTitulek}</title>
    <meta name="description" content={popis} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17140F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Ruční volba režimu (atlas-rezim) má přednost před nastavením systému; nastaví se před vykreslením.
      try {
        const r = localStorage.getItem('atlas-rezim');
        if (r === 'light' || r === 'dark') document.documentElement.dataset.theme = r;
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ klic: KLIC_AKTIVNI }}>
      // Hodina otevřená v této kartě (src/lib/pruchod-hodiny.ts): když na stránce stojí některé její zastavení,
      // drží se místo pro lištu hodiny a při promítání se stránka vykreslí rovnou bez hlavičky a patičky.
      try {
        var h = JSON.parse(sessionStorage.getItem(klic) || 'null');
        if (h && h.verze === 1 && !h.zavreno && Array.isArray(h.polozky)) {
          var p = location.pathname;
          if (p.charAt(p.length - 1) !== '/') p += '/';
          try { p = decodeURI(p); } catch (e) {}
          if (h.polozky.some(function (z) { return z && z.stranka === p; })) {
            document.documentElement.classList.add('s-hodinou');
            if (h.promitani) document.documentElement.classList.add('promitani');
          }
        }
      } catch (e) {}
    </script>
    <Pisma />
  </head>
  <body>
    <a class="preskocit" href="#obsah">Přeskočit na obsah</a>
    {Astro.slots.has('hlavicka') ? <slot name="hlavicka" /> : <Hlavicka sekce={sekce} zpet={zpet} titulek={kratkyTitulek} />}
    <ListaHodiny />
    {drobecky && <Drobecky cesta={drobecky} />}
    <main id="obsah" tabindex="-1" data-pagefind-body={hledat ? '' : undefined} class:list={{ aplikace }}>
      <slot />
    </main>
    {!aplikace && (
      <footer class:list={['paticka', 'stranka', 't-popisek', { 'paticka--lista': Astro.slots.has('lista') }]} data-pagefind-ignore>
        <p>Atlas myšlení · Vojtěch Czempka · texty a data CC BY-NC-SA 4.0, kód MIT</p>
        <p><a class="paticka__ucitel" href="/hodina/nova/">Pro učitele: připravit hodinu</a></p>
      </footer>
    )}
    {Astro.slots.has('lista') ? <slot name="lista" /> : <SpodniLista sekce={sekce} />}
    <script is:inline>
      // Pevná spodní lišta nesmí zakrýt prvek, na který přijde fokus z klávesnice. Prohlížeč stránku sám
      // neposune, když prvek leží ve viditelné části, byť pod lištou (scroll-padding na to nestačí).
      (() => {
        let klavesnice = false;
        addEventListener('keydown', () => { klavesnice = true; }, true);
        addEventListener('pointerdown', () => { klavesnice = false; }, true);
        addEventListener('focusin', (e) => {
          const prvek = e.target;
          if (!klavesnice || !(prvek instanceof Element)) return;
          // Lišta hodiny drží pod hlavičkou: prvek, na který přijde fokus při couvání (Shift+Tab), pod ní nezůstane.
          const horni = document.querySelector('[data-hodina-lista]');
          if (horni && horni.offsetHeight > 0 && !horni.contains(prvek) && !prvek.closest('.hlavicka, .cesta-hlavicka, .obsah-lista')) {
            requestAnimationFrame(() => {
              const r = prvek.getBoundingClientRect();
              const hrana = horni.getBoundingClientRect().bottom;
              if (r.top < hrana + 8 && r.bottom > 0) scrollBy({ top: r.top - hrana - 16, behavior: 'instant' });
            });
          }
          const lista = [...document.querySelectorAll('.cesta-lista, nav.lista')].find(
            (l) => getComputedStyle(l).position === 'fixed' && l.getBoundingClientRect().height > 0,
          );
          if (!lista || lista.contains(prvek)) return;
          requestAnimationFrame(() => {
            const r = prvek.getBoundingClientRect();
            const hrana = lista.getBoundingClientRect().top;
            const presah = r.bottom + 16 - hrana;
            // Prvek vyšší než volné místo neposouvej nad horní okraj.
            if (presah > 0 && r.top < hrana) scrollBy({ top: Math.min(presah, Math.max(0, r.top - 96)), behavior: 'instant' });
          });
        });
      })();
    </script>
    <script>
      // Lišta hodiny a promítání (src/scripts/hodina-lista.ts); bez aktivní hodiny v kartě nedělá nic.
      import { spustListuHodiny } from '../scripts/hodina-lista';
      spustListuHodiny();
    </script>
  </body>
</html>

<style>
  main { display: block; outline: none; }
  main.aplikace { overflow: hidden; }
  .paticka {
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    padding-bottom: calc(var(--spodni-lista) + var(--s-6));
    border-top: 1px solid var(--rule);
  }
  .paticka p { margin: 0; }
  .paticka__ucitel { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); }
  .paticka__ucitel:hover { color: var(--ink); }
  @media (min-width: 900px) {
    .paticka { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: var(--s-5); padding-bottom: var(--s-6); }
  }
  /* Vlastní spodní lišta (krok cesty) je vidět i na notebooku. */
  .paticka--lista, .paticka--lista:is(*) { padding-bottom: calc(var(--spodni-lista) + var(--s-7)); }
</style>
