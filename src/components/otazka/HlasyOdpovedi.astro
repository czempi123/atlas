---
// Odpovědi myslitelů na úvodní případ stránky velké otázky: karty vedle sebe (telefon pod sebou, od 700 px 2 sloupce),
// mince, jméno a jedna až dvě věty. Každá karta vede na rozvinutí téže osoby na časové ose (#hlas-<osoba>).
import type { TOsoba } from '../../lib/schema';
import Mince from '../ui/Mince.astro';
import Ikona from '../ui/Ikona.astro';
import { radek } from '../../lib/bloky';

interface Props {
  hlasy: { osoba: TOsoba; odpoved: string }[];
}
const { hlasy } = Astro.props;
---
<ul class="odpovedi">
  {hlasy.map((h) => (
    <li class={`odpoved obdobi-${h.osoba.obdobi}`}>
      <a class="odpoved__odkaz" href={`#hlas-${h.osoba.id}`}>
        <span class="odpoved__hlava">
          <span aria-hidden="true"><Mince osoba={h.osoba} varianta="tint" velikost={40} /></span>
          <span class="odpoved__jmeno t-ovladani-l">{h.osoba.jmeno}</span>
        </span>
        <span class="odpoved__text" set:html={radek(h.odpoved)} />
        <span class="odpoved__dal t-ovladani">Proč takhle? <Ikona id="dal" velikost={16} /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .odpovedi { display: grid; gap: var(--s-4); margin: 0; padding: 0; list-style: none; }
  .odpoved__odkaz {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--pc);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .odpoved__odkaz:hover { border-color: var(--pc); }
  .odpoved__odkaz:hover .odpoved__dal { text-decoration: underline; text-underline-offset: 0.15em; }
  .odpoved__hlava { display: flex; align-items: center; gap: var(--s-3); }
  .odpoved__jmeno { font-weight: 600; }
  .odpoved__text { font-family: var(--font-serif); font-size: var(--fs-text); line-height: 1.5; }
  .odpoved__dal { display: inline-flex; align-items: center; gap: var(--s-1); margin-top: auto; color: var(--ink-2); }
  @media (min-width: 700px) {
    .odpovedi { grid-template-columns: 1fr 1fr; }
  }
</style>
