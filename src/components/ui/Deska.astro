---
// Deska: duotónová plocha pro obraz (busta, freska, rukopis) v barvách období.
// Světlý režim: pozadí --period-N, kresba --period-N-tint; tmavý: pozadí soft, kresba barva.
// Dokud obraz chybí, ukazuje minci s atributem (nikdy generickou siluetu). Pod deskou vždy popisek.
import type { TOsoba } from '../../lib/schema';
import { data } from '../../lib/data';
import { ornamenty } from '../../lib/ornamenty.js';
import Mince from './Mince.astro';

interface Props {
  /** osoba: dává barvu období, minci s atributem a výchozí obraz */
  osoba?: TOsoba;
  /** období, když deska nepatří k osobě (např. scéna v Příběhu) */
  obdobi?: number;
  /** id obrázku v zdroje.yaml; přebije obraz osoby */
  obrazek?: string;
  /** false = nepoužít portrét osoby (scéna v Příběhu ukazuje místo, ne podobu); mince zůstává */
  obrazOsoby?: boolean;
  pomer?: string;
  class?: string;
}
const { osoba, obdobi: obdobiProp, obrazek: obrazekId, obrazOsoby = true, pomer = '4 / 5', class: trida } = Astro.props;
const obdobi = osoba?.obdobi ?? obdobiProp ?? 1;
const idObrazku = obrazekId ?? (obrazOsoby ? osoba?.obrazek : undefined);
const obrazek = idObrazku ? data.zdroje.obrazky.find((o) => o.id === idObrazku) : undefined;
if (idObrazku && !obrazek) throw new Error(`Obrázek „${idObrazku}“ není v zdroje.yaml`);
const orn = ornamenty.orn(obdobi - 1);
// Střed výřezu jde do proměnných: --vyrez platí všude, --vyrez-sirka pro desku na šířku (hlavička osobnosti na telefonu).
const vyrezStyl = [obrazek?.vyrez && `--vyrez:${obrazek.vyrez}`, obrazek?.vyrezNaSirku && `--vyrez-sirka:${obrazek.vyrezNaSirku}`].filter(Boolean).join(';') || undefined;
---
<figure class:list={['deska', `obdobi-${obdobi}`, trida]}>
  <div class="deska__plocha" style={`aspect-ratio:${pomer}`}>
    {obrazek ? (
      <img src={`/${obrazek.soubor}`} alt={obrazek.popisek} loading="lazy" style={vyrezStyl} />
    ) : (
      <>
        <svg class="deska__ornament" viewBox="0 0 160 128" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d={orn.solid} fill="currentColor" opacity="0.14" />
          <path d={orn.line} fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
        </svg>
        {osoba && <Mince osoba={osoba} varianta="ring" velikost={88} class="deska__mince" />}
      </>
    )}
  </div>
  <figcaption class="t-popisek"><slot>{obrazek?.popisek}</slot></figcaption>
</figure>

<style>
  .deska { margin: 0; }
  .deska__plocha {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--r-xs);
    background: var(--pc-plate);
    color: var(--pc-on-plate);
  }
  /* Duotón: šedotónový obraz násobený barvou desky, světla v barvě kresby. */
  .deska__plocha img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Busty a portréty: tvář bývá v horní třetině; při úzkém výřezu (telefon) se nesmí useknout.
       Obrázek s vlastním středem výřezu (`vyrez` v zdroje.yaml) ho přebije proměnnou na prvku. */
    object-position: var(--vyrez, 50% 25%);
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: luminosity;
  }
  .deska__ornament {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(closest-side, #000 30%, transparent);
    mask-image: radial-gradient(closest-side, #000 30%, transparent);
  }
  :global(.deska__mince) { position: relative; }
  figcaption { margin-top: var(--s-3); }
</style>
