---
// Mince: atribut osobnosti v kruhu s dvojitým okrajem (1,5 px barva období, mezera, 1 px soft).
// Varianty: ring (mapa, povrch), tint (karty), sel (vybraný člověk, plná barva). Nikdy iniciála.
import type { TOsoba } from '../../lib/schema';
import Ikona from './Ikona.astro';

interface Props {
  osoba: TOsoba;
  varianta?: 'ring' | 'tint' | 'sel';
  velikost?: number;
  class?: string;
}
const { osoba, varianta = 'tint', velikost = 40, class: trida } = Astro.props;
const a = osoba.atribut;
const popis = a ? `${osoba.jmeno} · ${a.nazev}` : osoba.jmeno;
---
{a ? (
  <span
    class:list={['mince', `mince--${varianta}`, `obdobi-${osoba.obdobi}`, trida]}
    style={`--v:${velikost}px`}
    role="img"
    aria-label={popis}
    title={popis}
  >
    <span class="mince__vnitrek">
      <Ikona sada="atributy" id={a.ikona} velikost={Math.round(velikost * 0.56)} />
    </span>
  </span>
) : (
  <span
    class:list={['mince', 'mince--bez', `obdobi-${osoba.obdobi}`, trida]}
    style={`--v:${velikost}px`}
    aria-hidden="true"
  ><span class="mince__vnitrek"></span></span>
)}

<style>
  .mince {
    --okraj: 1.5px;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--v);
    height: var(--v);
    padding: 2px;
    border: var(--okraj) solid var(--pc);
    border-radius: var(--r-full);
    background: var(--surface);
  }
  .mince__vnitrek {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid var(--pc-soft);
    border-radius: var(--r-full);
    color: var(--pc);
  }
  .mince--tint { background: var(--pc-tint); }
  .mince--tint .mince__vnitrek { background: var(--pc-tint); }
  .mince--sel { background: var(--pc); }
  .mince--sel .mince__vnitrek { background: var(--pc); color: var(--paper); border-color: color-mix(in srgb, var(--paper) 45%, transparent); }
  /* Bez schváleného atributu: jen dvojitý prstenec v barvě období, bez písmene. */
  .mince--bez { background: var(--surface); }
  .mince--bez .mince__vnitrek { background: var(--pc-tint); }
</style>
