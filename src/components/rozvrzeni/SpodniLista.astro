---
// Spodní lišta na telefonu: pět vstupů s ikonami a popisky.
import Ikona from '../ui/Ikona.astro';
import type { Sekce } from './Hlavicka.astro';

interface Props { sekce?: Sekce }
const { sekce } = Astro.props;
const vstupy = [
  { id: 'domu', href: '/', text: 'Domů', ikona: 'domu' },
  { id: 'mapa', href: '/mapa/', text: 'Mapa', ikona: 'mapa' },
  { id: 'otazky', href: '/otazky/', text: 'Otázky', ikona: 'otazky' },
  { id: 'lide', href: '/lide/', text: 'Lidé', ikona: 'lide' },
  { id: 'denik', href: '/denik/', text: 'Deník', ikona: 'denik' },
];
---
<nav class="lista" aria-label="Hlavní navigace" data-pagefind-ignore>
  <ul>
    {vstupy.map((v) => (
      <li>
        <a href={v.href} aria-current={sekce === v.id ? 'page' : undefined}>
          <Ikona id={v.ikona} velikost={24} />
          <span>{v.text}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lista {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    height: calc(var(--spodni-lista) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }
  ul { display: grid; grid-template-columns: repeat(5, 1fr); height: 100%; margin: 0; padding: 0; list-style: none; }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 100%;
    min-width: var(--dotyk);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
  }
  a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  a[aria-current='page'] span { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 900px) { .lista { display: none; } }
</style>
