---
// Drobečková navigace: vždy pod hlavičkou vlevo (Lidé a směry / období / osoba).
interface Props { cesta: { text: string; href?: string }[] }
const { cesta } = Astro.props;
---
<nav class="drobecky stranka t-popisek" aria-label="Kde jsem" data-pagefind-ignore>
  <ol>
    {cesta.map((c, i) => (
      <li>
        {c.href && i < cesta.length - 1 ? <a href={c.href}>{c.text}</a> : <span aria-current="page">{c.text}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .drobecky { padding-top: var(--s-4); padding-bottom: var(--s-2); }
  ol { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); margin: 0; padding: 0; list-style: none; }
  li { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--muted); }
  li + li::before { content: '/'; color: var(--muted); }
  a { color: var(--ink-2); text-decoration: none; min-height: 24px; display: inline-flex; align-items: center; }
  a:hover { color: var(--ink); text-decoration: underline; }
  [aria-current] { color: var(--ink); }
</style>
