---
// Kde je střed?: kresba k Aristotelovu středu „vzhledem k nám“ (cesta 4, krok 6). Na řece někdo volá o pomoc;
// student mění, kdo stojí na břehu a jaká je voda, a bod na čáře se posouvá. Značka v půli čáry stojí.
// Nic se neukládá a kresba nenabízí Kam dál.
// Použití v MDX: <KdeJeStred id="kde-je-stred" />
import Ostrov from '../ostrovy/KdeJeStred.svelte';

interface Props {
  /** kotva kresby */
  id?: string;
  /** barva období (1–8) */
  obdobi?: number;
}
const { id = 'kde-je-stred', obdobi = 1 } = Astro.props;
---
<Ostrov client:visible id={id} obdobi={obdobi} />
