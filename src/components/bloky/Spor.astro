---
// Spor dvou filozofů na škále. Obsah je v src/content/bloky/<id>.yaml (druh: spor).
// Použití v MDX: <Spor id="platon-diogenes-skutecnost" />  (volitelně dal={{ href, text }})
import Ostrov from '../ostrovy/Spor.svelte';
import { nactiBlok, odkazNaBlok, proOstrov, clovek, kamDal } from './_kontrola';
import type { ClovekBloku, Dal } from '../ostrovy/bloky-typy';

interface Props { id: string; dal?: Dal }
const { id, dal } = Astro.props;
const blok = await nactiBlok(id, 'spor', Astro.url.pathname);
// Strana bez osoby (autor, kterého atlas v datech nemá) se jmenuje označením a má prázdnou minci v barvě bloku.
const lide = blok.strany.map((s) => (s.osoba ? { ...clovek(s.osoba), oznaceni: s.oznaceni } : { jmeno: s.oznaceni!, obdobi: blok.obdobi, oznaceni: s.oznaceni })) as [ClovekBloku, ClovekBloku];
const dalsi = await kamDal(Astro.url.pathname, dal ?? blok.dal);
---
<Ostrov client:visible id={id} blok={proOstrov(blok)} lide={lide} odkaz={odkazNaBlok(Astro.url.pathname, id)} dal={dalsi} />
