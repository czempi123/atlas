---
// Zdvoj čtverec: kresba k chlapci z Menóna (portrét Platóna, kapitola 02). Mřížka stopa na stopu a tři pokusy
// o čtverec s dvojnásobným obsahem; student si nechá čtverečky spočítat. Nic se neukládá a kresba nenabízí Kam dál.
// Použití v MDX: <ZdvojCtverec id="zdvoj-ctverec" />
import Ostrov from '../ostrovy/ZdvojCtverec.svelte';

interface Props {
  /** kotva kresby */
  id?: string;
  /** barva období (1–8) */
  obdobi?: number;
}
const { id = 'zdvoj-ctverec', obdobi = 1 } = Astro.props;
---
<Ostrov client:visible id={id} obdobi={obdobi} />
