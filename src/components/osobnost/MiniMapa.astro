---
// Výřez mapy s místy, kde osoba žila, bojovala a zemřela. Podklad se počítá při sestavení z Natural Earth.
// Výřez: výchozí egejský, dokud se do něj vejdou všechna místa osoby; jinak podle míst (src/lib/mapa.ts, vyrezMiniMapy).
import type { TOsoba } from '../../lib/schema';
import { mistaPodleId } from '../../lib/data';
import { podklad, umisteniPopisku, vyrezMiniMapy, type MistoMiniMapy, type Vyrez } from '../../lib/mapa';
import { rok as fmtRok } from '../../lib/casy';

interface Props { osoba: TOsoba; vyrez?: Vyrez }
const ROLE: Record<string, string> = {
  narozeni: 'narození', studium: 'studia', pusobeni: 'působení', pobyt: 'pobyt', exil: 'vyhnanství', tazeni: 'válečné tažení', smrt: 'smrt',
};
// Místa sloučená podle id, s rolemi a roky.
const mista = new Map<string, MistoMiniMapy>();
for (const m of Astro.props.osoba.mista) {
  const misto = mistaPodleId.get(m.misto)!;
  const rok = m.rok ?? m.od;
  // Přibližný rok (priblizne v datech) nese „asi“, stejně jako letopočty života.
  const popis = `${ROLE[m.role]}${rok !== undefined ? ` ${m.priblizne ? 'asi ' : ''}${fmtRok(rok)}` : ''}`;
  const b = mista.get(m.misto) ?? { nazev: misto.nazev, souradnice: misto.souradnice as [number, number], radky: [] };
  b.radky.push(popis);
  mista.set(m.misto, b);
}
const { osoba, vyrez = vyrezMiniMapy([...mista.values()]) } = Astro.props;
const p = podklad(vyrez);
const body = [...mista.values()].map((m) => ({ nazev: m.nazev, xy: p.bod(m.souradnice), popis: m.radky }));
const vidimne = body.filter((b) => b.xy[0] > 0 && b.xy[0] < vyrez.sirka && b.xy[1] > 0 && b.xy[1] < vyrez.vyska);
// Strana popisku a jeho vysunutí nad bod, když by se řádky dvou míst potkaly (src/lib/mapa.ts).
const umisteni = umisteniPopisku(vidimne.map((b) => ({ xy: b.xy, nazev: b.nazev, radky: b.popis })), vyrez.sirka);
---
<figure class={`minimapa obdobi-${osoba.obdobi}`}>
  <svg viewBox={`0 0 ${vyrez.sirka} ${vyrez.vyska}`} role="img" aria-label={`Mapa: ${vidimne.map((b) => `${b.nazev} (${b.popis.join(', ')})`).join('; ')}`}>
    <rect width={vyrez.sirka} height={vyrez.vyska} class="more" />
    <path d={p.sit} class="sit" />
    <path d={p.pevnina} class="svit svit--1" />
    <path d={p.pevnina} class="svit svit--2" />
    <path d={p.pevnina} class="pevnina" />
    {vidimne.map((b, i) => {
      const vlevo = umisteni[i].strana === 'vlevo';
      return (
        <g transform={`translate(${b.xy[0]} ${b.xy[1]})`}>
          <circle r="6" class="bod" />
          <g class:list={['popisek', { 'popisek--nahoru': umisteni[i].nahoru }]} style={umisteni[i].nahoru ? `--radku:${b.popis.length}` : undefined}>
            <text x={vlevo ? -11 : 11} y="-2" class="nazev" text-anchor={vlevo ? 'end' : 'start'}>{b.nazev}</text>
            <text y="-2" class="role" text-anchor={vlevo ? 'end' : 'start'}>
              {b.popis.map((radek) => <tspan x={vlevo ? -11 : 11} dy="1.2em">{radek}</tspan>)}
            </text>
          </g>
        </g>
      );
    })}
    <g transform={`translate(16 ${vyrez.vyska - 18})`} class="meritko">
      <path d={`M0 0h${p.meritko.px}`} />
      <text y="-6">{p.meritko.km} km</text>
    </g>
  </svg>
  <figcaption class="t-popisek">Podklad: Natural Earth.</figcaption>
</figure>

<style>
  .minimapa { margin: 0; --fs-nazev: 15px; --fs-role: 13px; --fs-meritko: 12px; }
  svg { width: 100%; height: auto; border-radius: var(--r-xs); }
  .more { fill: var(--map-sea); }
  .sit { fill: none; stroke: var(--map-sea-line); stroke-width: 0.6; opacity: 0.7; }
  .svit { fill: none; stroke: var(--map-sea-line); stroke-linejoin: round; }
  .svit--1 { stroke-width: 16; opacity: var(--map-glow-1); }
  .svit--2 { stroke-width: 7; opacity: var(--map-glow-2); }
  .pevnina { fill: var(--map-land); stroke: var(--map-coast); stroke-width: 0.9; stroke-linejoin: round; }
  .bod { fill: var(--pc); stroke: var(--surface); stroke-width: 2; }
  /* Popisek vysunutý nad bod: poslední řádek rolí stojí vedle bodu, název nad ním. */
  .popisek--nahoru { transform: translateY(calc(var(--radku) * -1.2 * var(--fs-role))); }
  .nazev { font-family: var(--font-sans); font-size: var(--fs-nazev); font-weight: 600; fill: var(--ink); paint-order: stroke; stroke: var(--map-land); stroke-width: 4px; stroke-linejoin: round; }
  .role { font-family: var(--font-sans); font-size: var(--fs-role); fill: var(--ink-2); paint-order: stroke; stroke: var(--map-land); stroke-width: 4px; stroke-linejoin: round; }
  .meritko path { stroke: var(--ink-2); stroke-width: 2; }
  .meritko text { font-family: var(--font-sans); font-size: var(--fs-meritko); fill: var(--ink-2); }
  figcaption { margin-top: var(--s-2); }
  /* Na telefonu se SVG zmenší zhruba na 70 %, popisky proto zvětšíme. */
  @media (max-width: 700px) {
    .minimapa { --fs-nazev: 21px; --fs-role: 18px; --fs-meritko: 17px; }
  }
</style>
